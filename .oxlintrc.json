{
  // 各パッケージの .oxlintrc.json がこれを extends する。警告は使わず error / off の二値にする
  // ——警告は CI を落とさないので誰も読まず、決定論的な縛りにならない（#516）。
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/return-await": "error",
    "typescript/only-throw-error": "error",
    // catch で受けた unknown をそのまま reject へ渡す（握った例外の転送）は正当。
    "typescript/prefer-promise-reject-errors": ["error", { "allowThrowingUnknown": true }],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-explicit-any": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/no-deprecated": "error",
    // ! は外れても黙って undefined を流す。型の絞り込み・早期 return・値の持ち方で存在を
    // 保証する（#521）。
    "typescript/no-non-null-assertion": "error",
    // await の無い async は、同期の処理を Promise の契約へ合わせるために付けがちで、読み手に
    // 待ちがあると思わせる。契約に合わせるだけなら Promise.resolve で返す（#521）。
    "typescript/require-await": "error",
    // as は外れても実行時に何も確かめず、上流 JSON・Firestore・GCS の形の変化を黙って通す。
    // 境界の値は isRecord と型述語・パース関数で絞り、型の都合は構造（型述語・flatMap・
    // 型ごとのインスタンス）で合わせる（#521）。
    "typescript/no-unsafe-type-assertion": "error",
    // any を渡すと受け手の型が何も確かめないまま信じられ、上流の形の変化が呼び先の奥で崩れる。
    // JSON.parse・子プロセスの出力は unknown からパース関数で、.mjs の引数は JSDoc で型を持たせる
    // （#521）。
    "typescript/no-unsafe-argument": "error",
    // any を変数へ入れると、そこから先の読み書きが型の検査を受けずに通る。JSON.parse・上流の
    // 応答・型の無いモジュールは unknown で受けて絞る。expect.any の照合子も unknown で持つ（#521）。
    "typescript/no-unsafe-assignment": "error",
    // any のメンバーを読むと、その先は存在も型も確かめないまま進む。JSON.parse は unknown で
    // 受けて絞り、モックには本物の引数の型を持たせる（#521）。
    "typescript/no-unsafe-member-access": "error",
    // any を返すと、呼び手が受け取った値を型の検査なしに信じる。JSON.parse は unknown を返す
    // 関数で受け、Array.isArray は any[] へ絞るので型述語で包む。モックには本物の型を持たせる
    // （#521）。
    "typescript/no-unsafe-return": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "import/no-cycle": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    // Vitest の expect は第2引数に失敗時のメッセージを取る。
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // Testing Library の getBy* は見つからなければ投げるので、それ自体が表示の検査になる。
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expect*",
          "assertSucceeds",
          "assertFails",
          "screen.getBy*",
          "screen.getAllBy*"
        ]
      }
    ],
    // 日本語の文言・コメントの全角空白を誤検知する。
    "no-irregular-whitespace": [
      "error",
      { "skipComments": true, "skipStrings": true, "skipTemplates": true }
    ],

    // 件数が多く、直してから1つずつ error に上げる（#521）。
    "unicorn/consistent-function-scoping": "off",
    "vitest/require-mock-type-parameters": "off",
    // 返り値の欠けは tsc の noImplicitReturns で見る（#517）。こちらは網羅した switch の
    // 後ろの暗黙の undefined まで拾い、型で網羅を保証している関数を誤検知する。
    "typescript/consistent-return": "off",
    // その場で作った配列の sort / reverse まで拾う。破壊的な変更が共有された配列に
    // 及ぶ場面は型でも読みでも分かり、toSorted へ機械的に書き換える益が薄い。
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // モジュール内の非公開状態を _ で示す慣習を使っている。
    "no-underscore-dangle": "off",
    // then が値を返さないと次の then が undefined を受けることは、型が void として見せる。
    // 型の無い JS 向けの規則で、ここでは連鎖の途中で状態を書くだけの then を誤検知する。
    "promise/always-return": "off",
    // 単一の数を渡す new Array(n) が長さの指定か要素かは、型引数と引数の型で読める。
    // 長さを決めて fill する用途に Array.from({ length }) を強いる益が薄い。
    "unicorn/no-new-array": "off",
    // 導入時に全 21 件を見たが取り違えは無く、どれも同名の再利用だった（vi.hoisted の中の
    // クラス名、引数の value など）。名前を替えて避ける益が、読みにくさに見合わない。
    "no-shadow": "off"
  },
  "overrides": [
    {
      // テストの ! は「前提: ここで値がある」の表明で、外れればその場の TypeError か直後の
      // expect でテストが落ちる。本番の ! が危ないのは外れても黙って進むことで、テストでは
      // 黙らない。絞り込みに書き換えると前提の表明が if と throw に埋もれて読みにくくなる。
      "files": ["**/test/**", "**/e2e/**"],
      "rules": { "typescript/no-non-null-assertion": "off" }
    },
    {
      // テストの await の無い async は、Promise を返す依存の偽物（async () => 値）と、効果と
      // マイクロタスクを流し切らせる act(async () => ...) がほとんど。偽物の async は中の throw を
      // 本物どおり reject に変え、act は async を渡すかで流し方が変わる。Promise.resolve に
      // 書き換えると throw する偽物が同期で投げるようになり、偽物が本物から離れる。
      "files": ["**/test/**", "**/e2e/**"],
      "rules": { "typescript/require-await": "off" }
    },
    {
      // テストの as は、使う部分だけを持つ偽物を本物の型として渡す（Express の Request・
      // google.maps.Map・中身を見ない RoutePlan）のと、自分で作った応答やモックの呼び出しを
      // 既知の形として読むのがほとんど。形が外れればその場の TypeError か直後の expect で
      // 落ちる。本物の型を満たす偽物を組むと、検査と関係の無いフィールドがテストを埋める。
      "files": ["**/test/**", "**/e2e/**"],
      "rules": { "typescript/no-unsafe-type-assertion": "off" }
    }
  ]
}

{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "dev": "npm run build && GOOGLE_MAPS_API_KEY=$(security find-generic-password -a \"$USER\" -s \"GOOGLE_MAPS_API_KEY\" -w) firebase emulators:start --only functions",
    "test": "vitest run",
    "pack:local": "npm run build && node lib/timetable-pack/cli.js",
    "pack:bench": "npm run build && node lib/timetable-pack/bench.js",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "lint:deps": "depcruise --config ../.dependency-cruiser.cjs packages/engine/src packages/engine/test packages/engine/scripts apps/web/src apps/web/test apps/web/e2e apps/web/vite apps/web/scripts functions/src functions/test functions/scripts",
    "lint:policy": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/repo-policy/cli.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "fflate": "^0.8.3",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^18.8.0",
    "firebase": "^12.15.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  }
}

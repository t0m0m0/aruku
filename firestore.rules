rules_version = '2';

// このプロジェクトの Firestore はサーバ専用（Cloud Functions の Admin SDK のみが
// 利用する）。レートリミッタの rateLimits コレクションを含め、クライアント SDK から
// の読み書きは全面拒否する。Admin SDK はセキュリティルールをバイパスするため、
// レートリミッタの動作には影響しない。
//
// かつて本人に開けていた userSync/{uid} の例外は、同期を撤去したあとも「配布済みの
// クライアントを壊さないため」に残していたが、配布された版が無いため閉じた（#387）。 doc-consistency:keep
// 同期を作り直すときの手順は docs/security_hardening.md ⑥。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "vitest", "react"],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/jsx-key": "error",
    // 経路の区間など、並べ替えも途中の挿入も起きない固定の並びにだけ index を key にしている。
    // 安定した id を持たないデータに id を作らせる益が無い。
    "react/no-array-index-key": "off",
    // 新しい JSX 変換（tsconfig の jsx: react-jsx）では React を import しない。
    "react/react-in-jsx-scope": "off",
    // 以下3つは React Compiler 前提の規則。このアプリは Compiler を使っておらず、最新値を
    // ref に写す定石や、効果を起こし直すための依存（pathname など）を誤検知する。
    // 依存の漏れそのものは react-hooks/exhaustive-deps が見る。
    "react/refs": "off",
    "react/memo-dependencies": "off",
    "react/exhaustive-effect-dependencies": "off",
    // CSS とフォントは副作用の import で読み込む。
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "@fontsource*/**"] }]
  },
  "overrides": [
    {
      // Playwright のフィクスチャの use() は React の use ではない。
      "files": ["e2e/**"],
      "rules": { "react-hooks/rules-of-hooks": "off" }
    },
    {
      // テストは RoutePlan の一部を差し替えた写しを spread で作る（本体に copyWith が無い）。
      // 文字列の spread も語彙をコードポイントで数える意図どおりの使い方。
      "files": ["test/**"],
      "rules": { "typescript/no-misused-spread": "off" }
    }
  ]
}

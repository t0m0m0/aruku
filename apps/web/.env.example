# apps/web の設定の雛形。コピーして .env を作り、実値を入れる（.env は追跡しない）。
#   cp .env.example .env
#
# ここに入る値はバンドルへ焼かれ、ブラウザから読める。秘匿値を置かないこと
# （docs/security_hardening.md）。実際の保護はリファラー制限と App Check が担う。

# Cloud Functions プロキシのベース URL。未設定だと createRouteService が起動時に落ちる。
VITE_PROXY_BASE_URL=https://asia-northeast1-<project-id>.cloudfunctions.net

# 経路検索（Transit API）のベース URL。既定のままでよければ設定不要。
# VITE_TRANSIT_API_BASE_URL=https://api.transit.ls8h.com

# Firebase Web アプリの設定。秘匿値ではない（バンドルへ焼かれ、ブラウザから読める）が、
# プロジェクトごとに違うので .env で渡す。dart_defines.json の同名キーと同じ値。
VITE_FIREBASE_WEB_API_KEY=
VITE_FIREBASE_WEB_APP_ID=

# App Check の reCAPTCHA v3 サイトキー。空だと App Check を有効化できず、
# placesProxy / googleWalkProxy は 401 を返す（＝安全側）。
VITE_RECAPTCHA_SITE_KEY=

# 開発時の App Check デバッグトークン。Firebase Console の「App Check > アプリ >
# デバッグトークンを管理」に登録した値を置く。
#
# **これは秘密。** 持てば App Check を迂回して課金プロキシを叩ける。他の VITE_ と違い
# 本番バンドルへは焼かれない——読むのは src/firebase/app-check.ts の
# `if (import.meta.env.DEV)` の中だけで、本番ビルドでは分岐ごと消える。
# その性質は test/build/production-bundle.test.ts が実際にビルドして見張っている。
#
# 空にすると SDK が起動ごとに新しいトークンを生成してコンソールへ出すため、
# 登録し直しが要る。固定 UUID を1回登録するほうが早い。
VITE_APP_CHECK_DEBUG_TOKEN=
